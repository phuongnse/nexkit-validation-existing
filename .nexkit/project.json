      "sha256": "c04b0b3e215b55aa38061782fd05fedcf6dc23b2c2ddc689f47f798990e2825e"
    },
    ".github/workflows/nexkit-intake.yml": {
      "managed": true,
      "sha256": "228b8d2f16366b3f946be30fc65970d3de992f7a2a6cf601311d9b7fc50bc081"
