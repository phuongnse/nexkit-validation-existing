{
  "default_branch": "main",
  "defaults": {
    "application": "present",
    "checks": [
      {
        "argv": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_unit.py",
          "-v"
        ],
        "kind": "test",
        "name": "test",
        "report": {
          "format": "unittest"
        },
        "timeout_seconds": 120
      },
      {
        "argv": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_http.py",
          "-v"
        ],
        "kind": "e2e",
        "name": "e2e",
        "report": {
          "format": "unittest"
        },
        "timeout_seconds": 120
      },
      {
        "argv": [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_package.py",
          "-v"
        ],
        "kind": "test",
        "name": "package",
        "report": {
          "format": "unittest"
        },
        "timeout_seconds": 120
      }
    ],
    "decisions": [
      "Use public repositories and a repository-scoped runner on the authorized VPS.",
      "Use the official Codex CLI with a separate ChatGPT login for this consumer.",
      "Use gpt-6-luna with max reasoning for implementation and independent review.",
      "Keep untrusted verification and privileged controllers on GitHub-hosted runners.",
      "The owner accepted at most two delivery rounds and six Codex invocations per work item, including clarification, with limits.minutes=60 and command_seconds=120.",
      "Initial live acceptance is authorized for at most three work items across the two public consumers; do not increase model usage without an administrative decision.",
      "Preserve the Python 3.12+ standard-library label HTTP service, its documented behavior, unittest commands and real subprocess TCP E2E.",
      "Use the deterministic local ZIP builder for the authorized v0.1.0-test.1 release scope; an exact human candidate approval is still required.",
      "Proposed setup: consumer-owned composed delivery requires current NexKit checks and one native PR approval from phuongnse, with stale-review dismissal and no bypass actors.",
      "Proposed setup: human-review waits at most 2880 minutes without retaining a runner; request-changes uses only remaining delivery rounds and calls."
    ],
    "engine": {
      "auth": "chatgpt",
      "name": "codex",
      "version": "0.156.1"
    },
    "environment": {
      "agent_runner": [
        "self-hosted",
        "linux",
        "x64",
        "nexkit-validation-existing"
      ],
      "runner": "ubuntu-24.04",
      "setup": []
    },
    "knowledge": [
      "README.md"
    ],
    "limits": {
      "agent_calls": 6,
      "attempts": 2,
      "command_seconds": 120,
      "minutes": 60
    },
    "merge_method": "squash",
    "models": {
      "implement": "gpt-6-luna",
      "review": "gpt-6-luna"
    },
    "reasoning_effort": {
      "implement": "max",
      "review": "max"
    },
    "release": {
      "artifacts": [
        "dist/label-service-{version}.zip"
      ],
      "build": [
        "python3",
        "scripts/package.py",
        "--version",
        "{version}",
        "--commit",
        "{commit}"
      ],
      "enabled": true,
      "tag_prefix": "v"
    }
  },
  "files": {
    ".github/workflows/nexkit-clarify.yml": {
      "managed": true,
      "sha256": "9d772c752c4396d17d99e582d9d1acb138753648198b2d5b1eaed922363097b0"
    },
    ".github/workflows/nexkit-continue.yml": {
