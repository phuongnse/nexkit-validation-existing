      "managed": true,
      "sha256": "329aa341cdc5a06a01c8ede9afbd505ed7bf16a798452a6344ebf541545887c9"
    },
    ".nexkit/controls/review.md": {
      "managed": true,
      "sha256": "4a6bd90741df32e8d67d370727672d18c4c7b9d9fa1ace3f540a2495bf54c9a3"
    }
  },
  "kit": {
    "ref": "ace93ccb318091e2722042b2ac6e0f19b509ae3f",
    "repository": "phuongnse/nexkit",
    "version": "0.1.0-rc.1"
  },
  "pipelines": {
    "maintenance": {
      "agent_workflows": [
        ".github/workflows/nexkit-clarify.yml",
        ".github/workflows/nexkit-delivery.yml"
      ],
      "approvals": {
        "human-review": {
          "continuation": ".github/workflows/nexkit-continue.yml",
          "enabled": true,
          "minimum": 1,
          "mode": "pull_request",
          "on_rejection": "retry",
          "protects": [
            "merge"
          ],
          "reviewers": [
            "phuongnse"
          ],
          "subject": "candidate",
          "wait_minutes": 2880
        }
      },
      "entrypoints": {
        "clarify": ".github/workflows/nexkit-clarify.yml",
        "delivery": ".github/workflows/nexkit-delivery.yml",
        "intake": ".github/workflows/nexkit-intake.yml",
        "release": ".github/workflows/nexkit-release.yml"
      },
      "invocations": {
        "change-source": {
          "contract": "deliver",
          "minutes": 30,
          "model": "gpt-6-luna",
          "reasoning_effort": "max",
          "task": ".nexkit/controls/implement.md"
        },
        "evaluate": {
          "contract": "review",
          "minutes": 30,
          "model": "gpt-6-luna",
          "reasoning_effort": "max",
          "task": ".nexkit/controls/review.md"
        }
      },
      "settings": {}
    }
  },
  "repository": "phuongnse/nexkit-validation-existing",
  "schema": 2
}
